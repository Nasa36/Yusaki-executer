local function UpdateResponsive()
	local Camera = workspace.CurrentCamera

	if not Camera then
		return
	end

	local viewport = Camera.ViewportSize

	if viewport.X < 320 then
		Main.Size = UDim2.new(
			1,
			-14,
			0,
			math.min(Config.Height, viewport.Y - 20)
		)
	end

	task.defer(UpdateScriptCanvas)
end

