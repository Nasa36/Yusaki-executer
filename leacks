local function SetHubVisible(visible)
	HubOpen = visible

	if visible then
		Main.Visible = true

		Main.Size = UDim2.fromOffset(
			Config.Width - 15,
			Config.Height - 15
		)

		Tween(Main, {
			Size = UDim2.fromOffset(
				Config.Width,
				Config.Height
			)
		})
	else
		Tween(Main, {
			Size = UDim2.fromOffset(
				Config.Width - 15,
				Config.Height - 15
			)
		})

		task.delay(Config.AnimationTime, function()
			if not HubOpen then
				Main.Visible = false
			end
		end)
	end
end

