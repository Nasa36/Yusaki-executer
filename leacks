--// =========================================================
--// REFRESH
--// =========================================================

local function RefreshScripts()
	for _, child in ipairs(ScriptList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local query = string.lower(SearchBox.Text or "")
	local count = 0

	for _, scriptData in ipairs(Scripts) do
		local categoryMatch =
			CurrentCategory == "All"
			or scriptData.Category == CurrentCategory

		local nameMatch =
			query == ""
			or string.find(
				string.lower(scriptData.Name),
				query,
				1,
				true
			)

		local descriptionMatch =
			query == ""
			or string.find(
				string.lower(scriptData.Description or ""),
				query,
				1,
				true
			)

		if categoryMatch and (nameMatch or descriptionMatch) then
			CreateCard(scriptData)
			count += 1
		end
	end

	EmptyLabel.Visible = count == 0

	task.defer(function()
		task.wait()
		UpdateScriptCanvas()
	end)
end

