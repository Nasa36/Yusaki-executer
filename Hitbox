local function getTargets()
    local targets = {}

    -- NPCs dentro do Workspace
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model")
        and obj ~= LocalPlayer.Character
        and obj:FindFirstChildOfClass("Humanoid")
        and obj:FindFirstChild("HumanoidRootPart") then
            table.insert(targets, obj)
        end
    end

    return targets
end

local function createESP(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return
    end

    -- Highlight
    if _G.HighlightEnabled and not character:FindFirstChild("YusakiHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "YusakiHighlight"
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0
        highlight.Parent = character
    end

    -- Name
    if _G.NameEnabled and not character:FindFirstChild("YusakiName") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "YusakiName"
        billboard.Size = UDim2.new(0,150,0,30)
        billboard.StudsOffset = Vector3.new(0,3,0)
        billboard.AlwaysOnTop = true
        billboard.Parent = root

        local name = Instance.new("TextLabel")
        name.Size = UDim2.new(1,0,1,0)
        name.BackgroundTransparency = 1
        name.Text = character.Name
        name.TextColor3 = Color3.new(1,1,1)
        name.TextStrokeTransparency = 0
        name.TextSize = 13
        name.Font = Enum.Font.GothamBold
        name.Parent = billboard
    end

    -- Health Bar
    if _G.HealthEnabled and not character:FindFirstChild("YusakiHealth") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "YusakiHealth"
        billboard.Size = UDim2.new(0,100,0,6)
        billboard.StudsOffset = Vector3.new(0,2.5,0)
        billboard.AlwaysOnTop = true
        billboard.Parent = root

        local background = Instance.new("Frame")
        background.Size = UDim2.new(1,0,1,0)
        background.BackgroundColor3 = Color3.fromRGB(40,40,40)
        background.BorderSizePixel = 0
        background.Parent = billboard

        local health = Instance.new("Frame")
        health.Name = "Health"
        health.Size = UDim2.new(1,0,1,0)
        health.BackgroundColor3 = Color3.fromRGB(0,255,80)
        health.BorderSizePixel = 0
        health.Parent = background
    end
end

