--// Executar código
local function ExecuteCode()
    local Code = CodeBox.Text

    if Code == "" then
        return
    end

    local Function, Error = loadstring(Code)

    if not Function then
        warn("Erro no código: " .. tostring(Error))
        return
    end

    local Success, Result = pcall(Function)

    if not Success then
        warn("Erro durante execução: " .. tostring(Result))
    end
end

--// Iniciar loop
Start.MouseButton1Click:Connect(function()
    if Running then
        return
    end

    Running = true
    Start.Text = "RODANDO..."

    task.spawn(function()
        while Running do
            ExecuteCode()

            local Delay = tonumber(Interval.Text) or 0.1
            task.wait(math.max(0, Delay))
        end
    end)
end)

--// Parar loop
Stop.MouseButton1Click:Connect(function()
    Running = false
    Start.Text = "INICIAR"
end)

--// Abrir/fechar
local function ToggleGUI()
