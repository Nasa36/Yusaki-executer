--// Atualização da UI conforme o Slot ativo
local function UpdateSlotUI()
    local current = Slots[ActiveSlot]
    
    CodeBox.Text = current.Code
    IntervalBox.Text = tostring(current.Delay)
    
    for id, btn in ipairs(SlotButtons) do
        local isSelected = (id == ActiveSlot)
        local isRunning = Slots[id].Running
        
        local statusSymbol = isRunning and "🟢" or "🔴"
        btn.Text = "Slot " .. id .. " " .. statusSymbol
        
        if isSelected then
            btn.BackgroundColor3 = Color3.fromRGB(55, 55, 75)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            btn.TextColor3 = Color3.fromRGB(160, 160, 180)
        end
    end
    
    if current.Running then
        SlotStatusLabel.Text = "🟢 Executando"
        SlotStatusLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
        StartBtn.Text = "RODANDO..."
        StartBtn.BackgroundColor3 = Color3.fromRGB(30, 120, 60)
    else
        SlotStatusLabel.Text = "🔴 Parado"
        SlotStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
        StartBtn.Text = "INICIAR"
        StartBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    end
end

