-- Salvar texto e intervalo digitados em tempo real
CodeBox:GetPropertyChangedSignal("Text"):Connect(function()
    Slots[ActiveSlot].Code = CodeBox.Text
end)

IntervalBox:GetPropertyChangedSignal("Text"):Connect(function()
    local val = tonumber(IntervalBox.Text)
    if val then
        Slots[ActiveSlot].Delay = math.max(0.01, val)
    end
end)

-- Lógica para Executar um Slot em Loop
local function RunSlotLoop(slotId)
    local slot = Slots[slotId]
    if slot.Running then return end
    
    slot.Running = true
    UpdateSlotUI()
    
    task.spawn(function()
        while slot.Running do
            local code = slot.Code
            if code and code:gsub("%s+", "") ~= "" then
                local fn, err = loadstring(code)
                if fn then
                    local success, result = pcall(fn)
                    if not success then
                        warn("[YUSAKI LOOPS] Erro no Slot " .. slotId .. ": " .. tostring(result))
                    end
                else
                    warn("[YUSAKI LOOPS] Sintaxe inválida no Slot " .. slotId .. ": " .. tostring(err))
                end
            end
            
            local delayTime = slot.Delay or 0.1
            task.wait(math.max(0.01, delayTime))
        end
        UpdateSlotUI()
    end)
end

-- Lógica para Parar um Slot
local function StopSlotLoop(slotId)
    Slots[slotId].Running = false
    UpdateSlotUI()
end

