--// =========================================================
--// FUNÇÕES AUXILIARES DE COMBATE & BUSCA
--// =========================================================

local function EquipWeapon()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if backpack and humanoid then
        local weapon = backpack:FindFirstChild("Combat") or backpack:GetChildren()[1]
        if weapon and weapon:IsA("Tool") then
            humanoid:EquipTool(weapon)
        end
    end
end

local function GetTargetEntity(targetName)
    local searchArea = workspace:FindFirstChild("Main") or workspace[span_1](start_span)[span_1](end_span)
    for _, obj in ipairs(searchArea:GetDescendants()) do
        if obj.Name:lower():find(targetName:lower()) then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                return obj
            end
        end
    end
    return nil
end

local function AttackTarget(target)
    if not target then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local mobPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")

    if hrp and mobPart then
        hrp.CFrame = mobPart.CFrame * CFrame.new(0, 0, 3) -- Posiciona nas costas[span_2](start_span)[span_2](end_span)
    end

    EquipWeapon()

    if ServerRemote then
        pcall(function()
            ServerRemote:FireServer("Server", "Combat", "Swing", "Combat", 1)[span_3](start_span)[span_3](end_span)
        end)
    end
end

