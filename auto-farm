-- Loop Auto Boss
task.spawn(function()
    while true do
        if _G.YusakiConfig.AutoBoss then
            local boss = GetTargetEntity(_G.YusakiConfig.SelectedBoss)
            if boss then
                AttackTarget(boss)
            end
        end
        task.wait(0.1)
    end
end)

-- Loop Auto Quest / Mob Farm
task.spawn(function()
    while true do
        if _G.YusakiConfig.AutoQuest and not _G.YusakiConfig.AutoBoss then
            local questInfo = QuestData[_G.YusakiConfig.SelectedQuest]
            if questInfo then
                if ServerRemote then
                    pcall(function()
                        ServerRemote:FireServer("Server", "Quest", "Accept", questInfo.QuestName)
                    end)
                end
                
                local mob = GetTargetEntity(questInfo.MobName)
                if mob then
                    AttackTarget(mob)
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Loop Auto Skill
task.spawn(function()
    while true do
        if _G.YusakiConfig.AutoSkill then
            if ServerRemote then
                pcall(function()
                    ServerRemote:FireServer("Server", "Skill", "Use", 1)
                    ServerRemote:FireServer("Server", "Skill", "Use", 2)
                    ServerRemote:FireServer("Server", "Skill", "Use", 3)
                end)
            end
        end
        task.wait(0.5)
    end
end)

-- Loop Auto Click
