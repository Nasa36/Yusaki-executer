local function CreateToggle(text, configKey)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 32)
    Btn.BackgroundColor3 = _G.YusakiConfig[configKey] and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(30, 30, 40)
    Btn.Text = text .. ": " .. (_G.YusakiConfig[configKey] and "ON" or "OFF")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 11
    Btn.Parent = Container
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    Btn.MouseButton1Click:Connect(function()
        _G.YusakiConfig[configKey] = not _G.YusakiConfig[configKey]
        Btn.Text = text .. ": " .. (_G.YusakiConfig[configKey] and "ON" or "OFF")
        Btn.BackgroundColor3 = _G.YusakiConfig[configKey] and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(30, 30, 40)
    end)
    return Btn
end

