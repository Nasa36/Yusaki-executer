--// =========================================================
--// YUSAKI HUB - FULL GAME DUMPER & PLACE SAVER
--// =========================================================

repeat task.wait() until game:IsLoaded()

-- 1. SALVAR MAPA E ARQUIVOS COMPLETOS (.RBXL)
if saveinstance then
    pcall(function()
        print("[YUSAKI] Baixando arquivo completo do mapa (.rbxl)...")
        saveinstance({mode = "full", noscripts = false})
        warn("[YUSAKI] Projeto salvo com sucesso na pasta 'workspace' do seu executor!")
    end)
elseif noscripts then
    pcall(function()
        saveinstance()
    end)
end

-- 2. VARREDURA HIERÁRQUICA DE TODOS OS SERVIÇOS DO JOGO
local gameDump = {}
local totalObjects = 0

local servicesToScan = {
    game:GetService("Workspace"),
    game:GetService("ReplicatedStorage"),
    game:GetService("ReplicatedFirst"),
    game:GetService("Players"),
    game:GetService("Lighting"),
    game:GetService("MaterialService"),
    game:GetService("StarterGui"),
    game:GetService("StarterPack"),
    game:GetService("StarterPlayer"),
    game:GetService("SoundService"),
    game:GetService("TextChatService"),
    game:GetService("JointsService")
}

local function scanInstance(instance, depth)
    depth = depth or 0
    local indent = string.rep("  ", depth)
    local line = string.format("%s[%s] %s (%s)", indent, instance.ClassName, instance.Name, instance:GetFullName())
    table.insert(gameDump, line)
    totalObjects = totalObjects + 1

    for _, child in ipairs(instance:GetChildren()) do
        pcall(function()
            scanInstance(child, depth + 1)
        end)
    end
end

print("[YUSAKI] Escaneando todos os serviços e descendentes do jogo...")
for _, service in ipairs(servicesToScan) do
    pcall(function()
        table.insert(gameDump, "\n==========================================")
        table.insert(gameDump, "SERVIÇO: " .. service.ClassName)
        table.insert(gameDump, "==========================================")
        scanInstance(service, 0)
    end)
end

local resultText = "=== YUSAKI FULL GAME DUMP ===\n"
resultText = resultText .. "Place ID: " .. game.PlaceId .. "\n"
resultText = resultText .. "Total de Objetos Extraídos: " .. totalObjects .. "\n\n"
resultText = resultText .. table.concat(gameDump, "\n")

-- 3. SALVAMENTO DOS DADOS EM TEXTO
if writefile then
    local fileName = "Yusaki_FullGame_" .. game.PlaceId .. ".txt"
    pcall(function()
        writefile(fileName, resultText)
        warn("[YUSAKI] Dump de texto salvo em: " .. fileName)
    end)
end

if setclipboard then
    setclipboard(resultText)
    warn("[YUSAKI] Árvore completa de arquivos copiada para a área de transferência!")
end
