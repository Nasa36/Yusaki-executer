--// YUSAKI HUB - SCANNER COMPATÍVEL COM DELTA MOBILE
--// Cópia Automática + Janela de Leitura na Tela
--// =========================================================

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local StarterPack = game:GetService("StarterPack")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local MobsFound = {}
local WeaponsFound = {}
local AssetsFound = {}

local function AddUnique(tbl, item)
    if not table.find(tbl, item) then
        table.insert(tbl, item)
    end
end

-- 1. ESCANEAR MOBS E NPCS
for _, obj in ipairs(Workspace:GetDescendants()) do
    pcall(function()
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            local isPlayer = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character == obj then
                    isPlayer = true
                    break
                end
            end
            if not isPlayer then AddUnique(MobsFound, obj.Name) end
        end
    end)
end

-- 2. ESCANEAR ARMAS E FERRAMENTAS
local ToolContainers = {ReplicatedStorage, StarterPack, LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}
for _, container in ipairs(ToolContainers) do
    if container then
        for _, obj in ipairs(container:GetDescendants()) do
            pcall(function()
                if obj:IsA("Tool") then AddUnique(WeaponsFound, obj.Name) end
            end)
        end
    end
end

-- 3. ESCANEAR ASSETS
for _, obj in ipairs(game:GetDescendants()) do
    pcall(function()
        if obj:IsA("MeshPart") and obj.MeshId ~= "" then
            AddUnique(AssetsFound, "[Mesh] " .. obj.Name .. " -> " .. obj.MeshId)
        elseif obj:IsA("SpecialMesh") and obj.MeshId ~= "" then
            AddUnique(AssetsFound, "[SpecialMesh] " .. obj.Name .. " -> " .. obj.MeshId)
        elseif (obj:IsA("Decal") or obj:IsA("Texture")) and obj.Texture ~= "" then
            AddUnique(AssetsFound, "[Texture] " .. obj.Name .. " -> " .. obj.Texture)
        elseif obj:IsA("Sound") and obj.SoundId ~= "" then
            AddUnique(AssetsFound, "[Sound] " .. obj.Name .. " -> " .. obj.SoundId)
        elseif obj:IsA("Animation") and obj.AnimationId ~= "" then
            AddUnique(AssetsFound, "[Animation] " .. obj.Name .. " -> " .. obj.AnimationId)
        end
    end)
end

-- GERAR TEXTO COMPLETO
local dumpText = "=== YUSAKI DATA DUMP ===\n"
dumpText = dumpText .. "Place ID: " .. game.PlaceId .. "\n\n"

dumpText = dumpText .. "--- MOBS ENCONTRADOS (" .. #MobsFound .. ") ---\n"
for _, mob in ipairs(MobsFound) do dumpText = dumpText .. "• " .. mob .. "\n" end

dumpText = dumpText .. "\n--- ARMAS ENCONTRADAS (" .. #WeaponsFound .. ") ---\n"
for _, weapon in ipairs(WeaponsFound) do dumpText = dumpText .. "• " .. weapon .. "\n" end

dumpText = dumpText .. "\n--- ASSETS ENCONTRADOS (" .. #AssetsFound .. ") ---\n"
for _, asset in ipairs(AssetsFound) do dumpText = dumpText .. asset .. "\n" end

-- 4. COPIAR DIRETO PARA A ÁREA DE TRANSFERÊNCIA DO CELULAR
if setclipboard then
    setclipboard(dumpText)
    warn("[YUSAKI SCANNER] Todos os dados foram COPIADOS para a sua área de transferência!")
end

