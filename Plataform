--// =========================================================
--// LOOP PRINCIPAL (RENDERSTEPPED): ANIMAÇÃO RGB + PLATAFORMA
--// =========================================================
local hue = 0

RunService.RenderStepped:Connect(function()
    -- 1. Animação RGB das Bordas
    hue = (tick() * 0.35) % 1
    local rainbowColor = Color3.fromHSV(hue, 0.8, 1)

    for _, stroke in ipairs(RGBStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = rainbowColor
        end
    end

    -- 2. Atualização da Plataforma
    if Features.Platform.Enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        PlatformPart.Parent = workspace
        PlatformPart.Size = Vector3.new(Features.Platform.Size, 0.8, Features.Platform.Size)
        PlatformPart.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + Features.Platform.Height, hrp.Position.Z)
    else
        PlatformPart.Parent = nil
    end
end)

