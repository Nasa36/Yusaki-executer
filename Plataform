--// Refresh
local function RefreshScripts()
	for _, child in ipairs(ScriptList:GetChildren()) do
		if child:IsA("Frame") and child ~= EmptyLabel then
			child:Destroy()
		end
	end

	local query = string.lower(SearchBox.Text)
	local count = 0

	for _, scriptData in ipairs(Scripts) do
		local categoryMatch =
			CurrentCategory == "All"
			or scriptData.Category == CurrentCategory

		local nameMatch =
			query == ""
			or string.find(string.lower(scriptData.Name), query, 1, true)

		local descriptionMatch =
			query == ""
			or string.find(
				string.lower(scriptData.Description or ""),
				query,
				1,
				true
			)

		if categoryMatch and (nameMatch or descriptionMatch) then
			CreateCard(scriptData)
			count += 1
		end
	end

	EmptyLabel.Visible = count == 0
end

--// Categories
local function CreateCategory(name)
	local Button = New("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(math.max(48, #name * 7 + 18), 25),
		BackgroundColor3 = name == "All" and Config.Accent or Config.Secondary,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = name,
		TextSize = 9,
		TextColor3 = Config.Text
	}, CategoryBar)

	Corner(Button, 7)

	Button.MouseButton1Click:Connect(function()
		CurrentCategory = name

		for _, child in ipairs(CategoryBar:GetChildren()) do
			if child:IsA("TextButton") then
				Tween(child, {
					BackgroundColor3 =
						child.Name == CurrentCategory
						and Config.Accent
						or Config.Secondary
				}, 0.12)
			end
		end

		RefreshScripts()
	end)
end

