--// Feedback
local function ButtonFeedback(button)
	local original = button.BackgroundColor3

	Tween(button, {
		BackgroundColor3 = Config.Accent:Lerp(Color3.new(1, 1, 1), 0.18)
	}, 0.08)

	task.delay(0.08, function()
		if button and button.Parent then
			Tween(button, {
				BackgroundColor3 = original
			}, 0.12)
		end
	end)
end

--// Executor
local function ExecuteScript(scriptData)
	if not scriptData or not scriptData.Code then
		return false, "Código do script não encontrado."
	end

	if type(loadstring) ~= "function" then
		return false, "Loadstring não está disponível neste ambiente."
	end

	local success, compiled = pcall(loadstring, scriptData.Code)

	if not success or type(compiled) ~= "function" then
		return false, tostring(compiled)
	end

	local executed, result = pcall(compiled)

	if not executed then
		return false, tostring(result)
	end

	return true, result
end

