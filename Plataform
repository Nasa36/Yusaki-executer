-- Helpers de Design
local function ApplyCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
    return corner
end

local function ApplyStroke(parent, color, transparency, thickness, isRGB)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(80, 85, 110)
    stroke.Transparency = transparency or 0
    stroke.Thickness = thickness or 1.5
    stroke.Parent = parent
    
    if isRGB then
        table.insert(RGBStrokes, stroke)
    end
    
    return stroke
end

local function ApplyGradient(parent, color1, color2, angle)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color1),
        ColorSequenceKeypoint.new(1, color2)
    }
    gradient.Rotation = angle or 45
    gradient.Parent = parent
    return gradient
end

--// =========================================================
--// SISTEMA ARRASTÁVEL (TOUCH & MOUSE)
--// =========================================================
local function MakeDraggable(guiFrame, dragHandle)
    dragHandle = dragHandle or guiFrame
    local dragging = false
    local dragStart, startPos
    local moved = false

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = guiFrame.Position

            local con; con = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    con:Disconnect()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
            end
            guiFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    return function() return moved end
end

